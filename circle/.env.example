# Supabase project (can be the same project as Mira or a fresh one —
# the schema in supabase/schema.sql creates Circle's own tables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key, used server-side for entry scoring and summaries
ANTHROPIC_API_KEY=sk-ant-...
